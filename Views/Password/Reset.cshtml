@model Loom.Models.ResetPasswordModel
@{
    ViewData["Title"] = "Новый пароль";
}
<main class="container my-5" style="max-width:480px;">
    <h1 class="h2 mb-4">Новый пароль</h1>
    <form method="post" asp-action="Reset" asp-route-userId="" asp-route-token="">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <input asp-for="UserId" type="hidden">
        <input asp-for="Token" type="hidden">
        <label asp-for="Password" class="form-label">Новый пароль</label>
        <input asp-for="Password" autocomplete="new-password" class="form-control mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Повторите пароль</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control mb-3">
        <button type="submit" class="btn btn-primary w-100">Сменить пароль</button>
    </form>
    <a asp-action="Forgot" class="d-inline-block mt-3">Запросить новую ссылку</a>
</main>
