@model Loom.Models.ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановление пароля";
}
<main class="container my-5" style="max-width:480px;">
    <h1 class="h2 mb-4">Восстановление пароля</h1>
    @if (TempData["PasswordRecoveryMessage"] is string message)
    {
        <p class="alert alert-info" role="status">@message</p>
    }
    <form method="post" asp-action="Forgot">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" type="email" autocomplete="email" class="form-control mb-2">
        <span asp-validation-for="Email" class="text-danger"></span>
        <button type="submit" class="btn btn-primary w-100 mt-3">Отправить ссылку</button>
    </form>
    <a asp-controller="Account" asp-action="Login" class="d-inline-block mt-3">Вернуться ко входу</a>
</main>
