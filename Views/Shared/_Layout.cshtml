@using Microsoft.AspNetCore.Identity
@inject SignInManager<Loom.Models.ApplicationUser> SignInManager
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var storeName = Configuration["Store:Name"] ?? "Loom";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @storeName</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<header class="store-header">
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">@storeName</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Меню">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/#catalog">Коллекция</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Home/About">О Loom</a></li>
                </ul>
                <div class="store-actions">
                    @if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Admin"))
    {
        <a href="/Admin/Products" class="btn btn-outline-secondary">Товары</a>
        <a href="/Admin/Orders" class="btn btn-outline-secondary">Заказы</a>
        <a href="/Admin/Analytics/Sales/Page" class="btn btn-outline-secondary">Аналитика</a>
    }
    <a href="/Account" class="btn btn-primary">Личный кабинет</a>
}
else
{
    <a href="/Account/Login" class="btn btn-primary">Войти</a>
    <a href="/Account/Register" class="btn btn-outline-light">Регистрация</a>
}
                </div>
            </div>
            <a href="/Cart" class="store-cart">
                Корзина <span id="cart-count" class="badge" aria-live="polite">0</span>
            </a>
        </div>
    </nav>
</header>

@RenderBody()

<footer class="store-footer">
    <div class="container">
        <div class="footer-main">
            <a class="navbar-brand" href="/">@storeName</a>
            <p>Платформа для интернет-магазина одежды</p>
        </div>
        <div class="footer-meta">
            <small>© @DateTime.Now.Year @storeName</small>
            <a href="/Home/About">О Loom</a>
        </div>
    </div>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/script.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>